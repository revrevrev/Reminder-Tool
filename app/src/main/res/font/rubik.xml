<?xml version="1.0" encoding="utf-8"?>
<!--
    Downloadable font for Rubik (all weights).
    To use bundled fonts, place rubik_regular.ttf, rubik_medium.ttf,
    rubik_semibold.ttf, rubik_bold.ttf in this folder and update Type.kt.
    Download from: https://fonts.google.com/specimen/Rubik
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="Rubik"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>
